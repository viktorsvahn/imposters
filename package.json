{
  "name": "imposters",
  "version": "0.1.0",
  "description": "Imposters — (im)ages and (posters): a tile-based poster layout editor.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && node --test tests/e2e/"
  },
  "devDependencies": {
    "puppeteer-core": "^23.6.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  }
}
